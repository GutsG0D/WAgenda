{
  "manifest_version": 3,
  "name": "WAgenda",
  "version": "1.3",
  "description": "Agenda mensagens automáticas para o WhatsApp Web.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "unlimitedStorage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_title": "WAgenda"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "globals.js",
        "emojis.js",
        "utils.js",
        "ui.js",
        "scheduler.js",
        "content.js"
      ],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
